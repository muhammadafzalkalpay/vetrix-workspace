# Copy to apps/web/.env.local for local development.
# In production these come from GCP Secret Manager.

APP_URL=http://localhost:3000
LOG_LEVEL=info

# sandbox: calls and texts are simulated and labelled, never sent.
# live: real delivery through Twilio and SendGrid (their keys are then required).
# Required in production. Defaults to sandbox elsewhere.
MESSAGING_MODE=sandbox

# Neon registry database (8 tables). Each organization's clinic database
# (57 tables) is found through the registry, not listed here.
REGISTRY_DATABASE_URL=

# Local development only: a clinic database that the registry points to with
# database_ref "env:CLINIC_DATABASE_URL_DEV".
CLINIC_DATABASE_URL_DEV=

# Sign-in. Generate the secret with: openssl rand -base64 32
# Changing it signs everyone out.
BETTER_AUTH_SECRET=
# Sender address for sign-in emails and client email (verified in SendGrid).
EMAIL_FROM=

# Needed for real calls, texts and email
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SENDGRID_API_KEY=

# OpenAI (AI front desk). Without a key, the scripted sandbox AI answers.
# Model names come from platform.openai.com.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_REALTIME_MODEL=

# Error tracking (optional in development)
SENTRY_DSN=

# Public home page (no sign-in).
# "Call Riley" dials this number, the clinic's Twilio number.
PUBLIC_CALL_NUMBER=
# "Try Riley in your browser" uses this organization's clinic database (slug).
# Must be a sample clinic: visitors create sample clients and bookings there.
PUBLIC_SANDBOX_ORG=
