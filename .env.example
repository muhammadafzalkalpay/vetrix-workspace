# Copy to apps/web/.env.local for local development.
# In production these come from GCP Secret Manager.

APP_URL=http://localhost:3000
LOG_LEVEL=info

# Demo mode simulates calls and texts. Keep true for the client demo.
# When false, Twilio and SendGrid credentials are required.
VETRIX_DEMO_MODE=true

# Neon registry database (8 tables)
REGISTRY_DATABASE_URL=

# Demo clinic database (57 tables). In production, the registry
# resolves each organization's own database instead.
DEMO_CLINIC_DATABASE_URL=

# Needed for real calls, texts and email
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SENDGRID_API_KEY=
OPENAI_API_KEY=

# Error tracking (optional in development)
SENTRY_DSN=
