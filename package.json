{
  "name": "vetrix-workspace",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @vetrix/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx --env-file-if-exists=apps/web/.env.local packages/db/src/cli.ts migrate",
    "db:tenant:add": "tsx --env-file-if-exists=apps/web/.env.local packages/db/src/cli.ts tenant:add",
    "db:status": "tsx --env-file-if-exists=apps/web/.env.local packages/db/src/cli.ts status",
    "db:packs:publish": "tsx --env-file-if-exists=apps/web/.env.local packages/db/src/cli.ts packs:publish",
    "db:seed:sample": "tsx --env-file-if-exists=apps/web/.env.local packages/db/src/cli.ts seed:sample",
    "db:staff:add": "tsx --env-file-if-exists=apps/web/.env.local packages/db/src/cli.ts staff:add"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "vitest": "^3.2.7"
  }
}
