    { "id": "dental_xray", "name": "Dental x-ray", "default_count": 1, "exclusive": true },
    { "id": "dental_station", "name": "Dental station", "default_count": 1, "exclusive": true },
    { "id": "ultrasound", "name": "Ultrasound", "default_count": 1, "exclusive": true },
    { "id": "lab_analyzer", "name": "In-house lab analyzer", "default_count": 1, "exclusive": false },
    { "id": "microchip_scanner", "name": "Microchip scanner", "default_count": 2, "exclusive": false }
