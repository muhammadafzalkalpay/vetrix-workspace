{
  "vertical_id": "veterinary",
  "room_types": [
    { "id": "exam", "label_key": "room_type.exam", "bookable": true, "default_count": 3, "notes": "Standard exam room for dogs and cats." },
    { "id": "cat_exam", "label_key": "room_type.cat_exam", "bookable": true, "default_count": 1, "notes": "Cat-only room. Preferred for patients flagged fear_free or species cat when free." },
    { "id": "surgery", "label_key": "room_type.surgery", "bookable": true, "default_count": 1, "notes": "One procedure at a time. Blocks on anesthesia_machine." },
    { "id": "dental", "label_key": "room_type.dental", "bookable": true, "default_count": 1, "notes": "Dental cleanings under anaesthesia. If the clinic has no dental suite, map to surgery." },
    { "id": "radiology", "label_key": "room_type.radiology", "bookable": true, "default_count": 1, "notes": "Holds the digital x-ray unit." },
    { "id": "treatment", "label_key": "room_type.treatment", "bookable": true, "default_count": 1, "capacity": 4, "notes": "Open area with multiple tables. Capacity is concurrent technician appointments." },
    { "id": "comfort", "label_key": "room_type.comfort", "bookable": true, "default_count": 1, "notes": "Quiet room for euthanasia and difficult conversations. If none, map to exam with a 15 minute buffer on both sides." },
    { "id": "isolation", "label_key": "room_type.isolation", "bookable": true, "default_count": 1, "notes": "Suspected contagious cases (parvo, kennel cough, ringworm). Staff-booked only." },
    { "id": "kennel", "label_key": "room_type.kennel", "bookable": true, "default_count": 1, "capacity": 8, "notes": "Hospitalisation and drop-off capacity. Capacity is concurrent drop-off patients." }
  ],
  "equipment_types": [
