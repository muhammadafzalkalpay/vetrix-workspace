{
  "vertical_id": "veterinary",
  "evaluate_on": "every_caller_utterance",
  "classification": {
    "method": "llm_intent",
    "phrases_are": "examples_not_exhaustive",
    "exclude_known_pet_names": true,
    "when_unsure": "escalate",
    "never_lower_level_within_call": true
  },
  "never_downgrade": true,
  "levels": {
    "emergency": {
      "action_in_hours": "transfer_now",
      "action_after_hours": "er_referral",
      "after_hours_also_book_next_available": "setting:after_hours_book_next_available",
      "log_as": "emergency",
      "transfer_summary_template": "Emergency: {{trigger_name}}. {{patient_name}}, {{species}}, {{age_band}}. Caller {{client_first_name}} {{mobile}}."
    },
    "urgent": {
      "action": "book_same_or_next_day",
      "service_id": "sick_visit",
      "fallback_if_no_slot": "drop_off_visit",
      "fallback_if_no_drop_off": "er_referral_or_waitlist_priority",
      "set_triage_level": "urgent",
      "log_as": "urgent"
    },
    "routine": {
      "action": "continue_booking",
      "set_triage_level": "routine"
    }
  },
