  "after_hours_er": {
    "setting_keys": [
      "er_name",
      "er_phone",
      "er_address"
    ],
    "sms_template": "{{clinic_name}}: For emergencies while we're closed please go to {{er_name}}, {{er_address}}. Phone {{er_phone}}."
  },
  "scripts": {
    "emergency_in_hours": "That sounds like it needs a doctor right away. I am connecting you to the team now.",
    "emergency_after_hours": "That sounds like it needs a doctor right away. We are closed at the moment, so please go to {{er_name}} at {{er_address}}. Their number is {{er_phone}}. I will text that to you now.",
    "emergency_transfer_failed": "I couldn't reach the team. Please go straight to {{er_name}} at {{er_address}}, {{er_phone}}. I'm texting that to you and alerting our staff now.",
    "urgent_booked": "Let's get {{patient_name}} seen today. I have {{slot_1}} or {{slot_2}}. If anything gets worse before then, please go to {{er_name}} or call us straight back.",
    "urgent_no_slot": "We're fully booked today, but I can set {{patient_name}} up as a drop-off this morning so the doctor can see them between appointments. Would that work?",
    "caller_downplays": "I understand. Even so, with what you've described I'd rather have the team take a look right away. Let me connect you.",
    "advice_requested": "I am not able to give medical advice, but I can get {{patient_name}} seen. The next available is {{slot_1}} or {{slot_2}}."
  },
  "staff_alert": {
    "on_emergency_after_hours": true,
    "on_transfer_failed": true,
    "channels": [
      "dashboard_banner",
      "sms_to_on_call_if_configured"
    ]
  }
}